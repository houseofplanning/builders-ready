# pnpm config for the Builders Ready monorepo.
#
# React Native + Expo expect a flat node_modules layout (like npm gives).
# pnpm uses nested symlinks by default, which breaks Metro/Expo plugin
# resolution. Hoisting Expo/RN packages to the top of node_modules fixes it.

node-linker=hoisted
auto-install-peers=true

# Hoist anything Expo / RN / React-Navigation related so Metro's resolver
# can find them without traversing pnpm's nested store layout.
public-hoist-pattern[]=*expo*
public-hoist-pattern[]=*react-native*
public-hoist-pattern[]=@expo/*
public-hoist-pattern[]=@react-native/*
public-hoist-pattern[]=@react-native-async-storage/*
public-hoist-pattern[]=@react-native-community/*
