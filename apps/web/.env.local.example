# Builders Ready — web env vars. Copy to .env.local and fill in.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://gxebyfkfrzijdpzntrkh.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<paste anon key from Supabase Settings -> API>
SUPABASE_SERVICE_ROLE_KEY=<paste service_role key — server-only — never commit>

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER_MONTHLY=price_...
STRIPE_PRICE_STARTER_ANNUAL=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_ANNUAL=price_...
STRIPE_PRICE_UNLIMITED_MONTHLY=price_...
STRIPE_PRICE_UNLIMITED_ANNUAL=price_...

# --- Resend (transactional email) ---
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL="Builders Ready <hello@notify.buildersready.uk>"

# --- Sentry ---
SENTRY_DSN=https://...@...sentry.io/...

# --- App URLs ---
NEXT_PUBLIC_MARKETING_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
