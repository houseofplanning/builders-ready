{
  "expo": {
    "name": "Builders Ready",
    "slug": "builders-ready",
    "scheme": "br-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4F6F7"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "uk.buildersready.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Builders Ready uses the camera so your builder can post photos of progress on your project.",
        "NSPhotoLibraryUsageDescription": "Builders Ready needs photo library access so your builder can attach images to project updates.",
        "NSFaceIDUsageDescription": "Use Face ID to unlock Builders Ready quickly and securely.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "uk.buildersready.app",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F4C5C"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-local-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Builders Ready needs photo library access so your builder can attach images to project updates.",
          "cameraPermission": "Builders Ready uses the camera so your builder can post photos of progress on your project."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#E07A5F"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3502ad22-f279-40ac-a3ea-ac844986c464"
      }
    },
    "owner": "oddiemehraj"
  }
}
